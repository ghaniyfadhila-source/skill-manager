{
  "name": "@ghaniy_fadhil/skill-manager",
  "version": "0.1.0",
  "description": "Kelola satu Library skill AI dan pasang salinannya ke banyak harness dari browser lokal.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.20"
  },
  "packageManager": "pnpm@12.8.1",
  "bin": {
    "skill-manager": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "commander": "^15.0.0",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghaniyfadhila-source/skill-manager.git"
  },
  "homepage": "https://github.com/ghaniyfadhila-source/skill-manager#readme",
  "bugs": {
    "url": "https://github.com/ghaniyfadhila-source/skill-manager/issues"
  },
  "keywords": [
    "skill",
    "ai",
    "cli",
    "claude-code",
    "opencode",
    "antigravity",
    "agents",
    "skill-manager"
  ]
}
